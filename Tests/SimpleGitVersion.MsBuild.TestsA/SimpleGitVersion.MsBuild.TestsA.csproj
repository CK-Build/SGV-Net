<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <LangVersion>13</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
        <PackageReference Include="CSemVer" Version="12.0.3" />
        <!-- Build order only. No actual reference to the SimpleGitVersion.MsBuild here. -->
        <ProjectReference Include="SimpleGitVersion.MSBuild" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CK.Testing.NUnit" Version="14.0.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Playground\Remotes\" />
    </ItemGroup>
    
    <!-- Consider the Playground folder as pure content: their .csproj are ignored by the build system. -->
    <ItemGroup>
        <Content Include="$(Content);Playground\**" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Playground\**" />
    </ItemGroup>


</Project>
